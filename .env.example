# Copy this file to .env and fill in your values.
# .env must never be committed — it is in .gitignore and .claudeignore.

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail — sender addresses to pull newsletters from (comma-separated)
NEWSLETTER_SENDERS=tldr@tldr.tech,changelog@changelog.com

# Gmail — your own address (used to filter/confirm the mailbox)
MY_EMAIL=you@gmail.com

# SMTP — for email delivery.
# SMTP_PASSWORD must be a Gmail App Password (16 chars), NOT your account password.
# Generate one at myaccount.google.com/apppasswords — see docs/GMAIL_SETUP.md.
# This same App Password is what IMAP reading uses too (see below).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# IMAP — how newsletters are read. Replaced the Gmail API's OAuth2 flow on 2026-09-15
# (restricted scopes forced a 7-day refresh token expiry — see docs/DECISIONS.md).
# IMAP_USER/IMAP_PASSWORD are optional: they default to SMTP_USER/SMTP_PASSWORD, since
# it's the same mailbox and the same App Password. Only set them to read from a
# different account than you send from.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=your_gmail_app_password_here

# Recipients — comma-separated, add coworkers here when ready
RECIPIENT_EMAILS=you@gmail.com,coworker@cobaltix.com

# Developer alert address — receives a failure notification if the pipeline errors.
# Defaults to the first RECIPIENT_EMAIL if not set.
DEVELOPER_EMAIL=you@gmail.com

# How many days back to pull emails (default 4)
LOOKBACK_DAYS=4

# TTS voice model name — must match a model baked into the Docker image.
# Changing this requires updating the model download in the Dockerfile and rebuilding.
# Available voices: https://rhasspy.github.io/piper-samples/
TTS_VOICE=en_GB-jenny_dioco-medium

# Playback speed — ffmpeg atempo value. Pitch is preserved regardless of speed.
# 1.0 = normal speed, 1.5 = 50% faster, 2.0 = double speed. Range: 0.5 to 2.0.
TTS_SPEED=1.5
